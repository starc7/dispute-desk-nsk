# Copy this file to .env and fill in your key.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Which Claude model to use. Change it here without touching code.
CLAUDE_MODEL=claude-sonnet-5-5

# Port for the server. Hosting platforms usually set this for you.
PORT=8787

# Max AI calls per visitor IP in a 10-minute window (protects your key when deployed).
RATE_LIMIT_PER_10_MIN=40
